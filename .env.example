# Environment Variables for MCP Tree-sitter Server Docker Compose
# Copy this file to .env and adjust values as needed
# Usage: cp .env.example .env

# ==============================================================================
# Project Configuration
# ==============================================================================

# Path to the project you want to analyze
# Default: current directory (.)
PROJECT_PATH=.

# Path to custom configuration file (optional)
# Uncomment and set if you want to use a custom config.yaml
# CONFIG_PATH=./config

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# Default: INFO (use DEBUG for troubleshooting)
LOG_LEVEL=INFO

# ==============================================================================
# Cache Configuration
# ==============================================================================

# Enable/disable parse tree caching
# Default: true
CACHE_ENABLED=true

# Maximum cache size in MB
# Default: 100 (increase for large projects)
# Recommended: 100-500 depending on project size
CACHE_MAX_SIZE_MB=100

# Cache entry time-to-live in seconds
# Default: 300 (5 minutes)
# Increase for stable codebases, decrease for active development
CACHE_TTL_SECONDS=300

# ==============================================================================
# Security Configuration
# ==============================================================================

# Maximum file size to parse in MB
# Default: 5
# Files larger than this will be skipped
MAX_FILE_SIZE_MB=5

# ==============================================================================
# Language Configuration
# ==============================================================================

# Preferred languages to pre-load at startup (comma-separated)
# Default: none (languages loaded on-demand)
# Example: python,javascript,typescript,go,rust
# PREFERRED_LANGUAGES=python,javascript,typescript

# ==============================================================================
# Resource Limits
# ==============================================================================

# CPU limits (used in docker-compose deploy section)
# Uncomment and adjust if needed
# CPU_LIMIT=2
# CPU_RESERVATION=0.5

# Memory limits (used in docker-compose deploy section)
# Uncomment and adjust if needed
# MEMORY_LIMIT=1G
# MEMORY_RESERVATION=256M

# ==============================================================================
# Development Settings (for docker-compose.dev.yml)
# ==============================================================================

# Development-specific settings
# These override the production defaults when using docker-compose.dev.yml

# Higher cache limit for development
# DEV_CACHE_MAX_SIZE_MB=200

# Longer TTL for development
# DEV_CACHE_TTL_SECONDS=600

# Larger file size limit for development
# DEV_MAX_FILE_SIZE_MB=10

# ==============================================================================
# Advanced Configuration
# ==============================================================================

# Path to YAML configuration file inside container
# Only set if using mounted config file
# MCP_TS_CONFIG_PATH=/config/config.yaml

# Additional environment variables can be added as MCP_TS_*
# See docs/docker/CLAUDE_INTEGRATION.md for complete list

# ==============================================================================
# Usage Examples
# ==============================================================================

# Basic usage:
#   docker-compose up
#
# Development:
#   docker-compose -f docker-compose.dev.yml up
#
# With custom .env file:
#   docker-compose --env-file .env.custom up
#
# Override single variable:
#   LOG_LEVEL=DEBUG docker-compose up
#
# Build and run:
#   docker-compose up --build

# ==============================================================================
# Notes
# ==============================================================================

# 1. All paths should be absolute or relative to docker-compose.yml location
# 2. Windows users: Use forward slashes (/) in paths, not backslashes (\)
# 3. Don't commit .env file with sensitive data to version control
# 4. Restart containers after changing .env: docker-compose restart
# 5. See documentation for more details: docs/docker/DEPLOYMENT.md
