# Development Dockerfile for MCP Tree-sitter Server
# This image includes development tools and dependencies

FROM python:3.10-slim

LABEL maintainer="Wrale LTD <contact@wrale.com>"
LABEL description="MCP Tree-sitter Server - Development Environment"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MCP_TS_LOG_LEVEL=DEBUG \
    PYTHONPATH=/app

# Install build and runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    pkg-config \
    python3-dev \
    git \
    curl \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for development
RUN groupadd -r mcp --gid=1000 && \
    useradd -r -g mcp --uid=1000 --home-dir=/home/mcp --shell=/bin/bash mcp && \
    mkdir -p /home/mcp && \
    chown -R mcp:mcp /home/mcp

# Create application directories
RUN mkdir -p /app /workspace /cache /config && \
    chown -R mcp:mcp /app /cache /home/mcp

# Set working directory
WORKDIR /app

# Copy dependency files
COPY --chown=mcp:mcp pyproject.toml ./

# Upgrade pip and install build tools
RUN pip install --upgrade pip setuptools wheel hatchling

# Install all dependencies from pyproject.toml
# We install dependencies manually to avoid needing the source code at build time
RUN pip install \
    'mcp[cli]>=0.12.0' \
    'tree-sitter>=0.20.0' \
    'tree-sitter-language-pack>=0.6.1' \
    'pyyaml>=6.0' \
    'pydantic>=2.0.0' \
    'types-pyyaml>=6.0.12.20241230' \
    'pytest>=7.0.0' \
    'pytest-cov>=4.0.0' \
    'ruff>=0.0.262' \
    'mypy>=1.2.0'

# Note: Source code (src/, tests/) will be mounted as volumes at runtime
# This allows live code changes without rebuilding the image

# Switch to non-root user
USER mcp

# Set working directory
WORKDIR /app

# Volume mount points for development
# Mount your source code: -v ./src:/app/src:ro
# Mount your tests: -v ./tests:/app/tests:ro
# Mount workspace: -v /path/to/project:/workspace:ro
VOLUME ["/app/src", "/app/tests", "/workspace", "/cache", "/config"]

# No entrypoint for dev - allows flexible usage
# Default command for development (interactive shell)
# Usage examples:
#   Interactive: docker run -it --rm -v ./src:/app/src mcp-server-tree-sitter:dev
#   Run tests: docker run --rm -v ./src:/app/src -v ./tests:/app/tests mcp-server-tree-sitter:dev pytest
#   Run server: docker run -i --rm -v ./src:/app/src -v ./:/workspace:ro mcp-server-tree-sitter:dev python -m mcp_server_tree_sitter.server
CMD ["/bin/bash"]
